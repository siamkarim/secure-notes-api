NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string, or mongodb://127.0.0.1:27017/secure-notes for local
MONGODB_URI=mongodb://127.0.0.1:27017/secure-notes

# Two DIFFERENT random secrets, at least 32 characters each.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the app (Render = 1)
TRUST_PROXY=1

# Used only by `npm run seed:admin`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
