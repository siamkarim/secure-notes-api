    {
      "name": "Notes",
      "item": [
        {
          "name": "List my notes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notes?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notes"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Index: { owner: 1, _id: -1 }"
          }
        },
        {
          "name": "Create note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notes"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My first note\",\n  \"body\": \"Hello\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('noteId', pm.response.json().note._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get note",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notes/{{noteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notes",
                "{{noteId}}"
              ]
            },
            "description": "Owner or admin."
          }
        },
        {
          "name": "Update note",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notes/{{noteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notes",
                "{{noteId}}"
              ]
            },
            "description": "Owner only.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Renamed note\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete note",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notes/{{noteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notes",
                "{{noteId}}"
              ]
            },
            "description": "Owner only."
          }
        }
      ]
    },
    {
      "name": "Aggregations",
      "item": [
        {
          "name": "Scenario 1: users grouped by interest",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/by-interest?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "by-interest"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "One aggregate() call. Optional: `interest=chess`, `cursor=<last interest name>`. Index: { interests: 1 }"
          }
        },
        {
          "name": "Scenario 2: posts of a user ($lookup)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/posts?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "posts"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Public. One pipeline with $lookup. Index: { author: 1, _id: -1 }",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Create post",
          "request": {
            "method": "POST",
