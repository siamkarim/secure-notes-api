                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My first post\",\n  \"body\": \"Visible to everyone\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
